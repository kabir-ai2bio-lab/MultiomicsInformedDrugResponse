install.packages("httr")
install.packages("jsonlite")
install.packages("dplyr")
library(jsonlite)
library(dplyr)
get_chembl_id <- function(drug_name){
url <- paste0(
"https://www.ebi.ac.uk/chembl/api/data/molecule.json?pref_name__iexact=",
drug_name
)
response <- GET(url)
data <- fromJSON(content(response, "text"))
if(length(data$molecules) > 0){
return(data$molecules$chembl_id[1])
} else {
return(NA)
}
}
get_chembl_id("Vinblastine")
install.packages("httr")   # only needed once
library(httr)
cat("\014")
get_targets <- function(chembl_id){
url <- paste0(
"https://www.ebi.ac.uk/chembl/api/data/mechanism.json?molecule_chembl_id=",
chembl_id
)
response <- GET(url)
data <- fromJSON(content(response, "text"))
if(length(data$mechanisms) > 0){
return(
data$mechanisms %>%
select(
molecule_chembl_id,
target_chembl_id,
mechanism_of_action
)
)
}
}
get_targets("CHEMBL159")
get_gene <- function(target_id){
url <- paste0(
"https://www.ebi.ac.uk/chembl/api/data/target/",
target_id
)
response <- GET(url)
data <- fromJSON(content(response, "text"))
return(data$target_components$target_component_synonyms)
}
