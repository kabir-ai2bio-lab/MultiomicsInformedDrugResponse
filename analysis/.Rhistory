get_chembl_id <- function(drug_name){
drug_name <- URLencode(trimws(drug_name))
url <- paste0(
"https://www.ebi.ac.uk/chembl/api/data/molecule.json?pref_name__iexact=",
drug_name
)
response <- GET(url)
data <- fromJSON(content(response, "text"))
if(length(data$molecules) > 0){
return(data$molecules$chembl_id[1])
} else {
return(NA)
}
}
drug_ids <- data.frame(
Drug = candidate_drugs
) %>%
mutate(
Chembl_ID = sapply(Drug, get_chembl_id)
)
